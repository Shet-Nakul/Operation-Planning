# Database connection
DATABASE_URL="postgresql://user:password@localhost:5432/hospital_scheduling"
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/hospital_shadow"
# JWT configuration
JWT_SECRET="super_secret_access_token_key"
JWT_REFRESH_SECRET="super_secret_refresh_token_key"
JWT_ACCESS_EXPIRATION="90d"
JWT_REFRESH_EXPIRATION="7d"

# Server configuration
BINDING_ADDRESS=127.0.0.1
PORT=8010
NODE_ENV=development

# LOG_LEVEL=trace   # Show everything
# LOG_LEVEL=debug   # Development (recommended)
# LOG_LEVEL=info    # Production (recommended)
# LOG_LEVEL=warn    # Warnings and errors only
# LOG_LEVEL=error   # Errors only
# LOG_LEVEL=fatal   # Fatal errors only
# LOG_LEVEL=silent  # No logs
LOG_LEVEL=info

# CORS allowed origins
CORS_ORIGIN=http://127.0.0.1:8010
WEBSOCKET_URL_ROSTER=ws://127.0.0.1:8000/scheduling/
WEBSOCKET_URL_PLANNING=ws://127.0.0.1:8000/planning
WEBSOCKET_URL_PLANNING_FEASIBILITY=ws://127.0.0.1:8000/planning/feasibility
WEBSOCKET_URL_PLANNING_SINGLE=ws://127.0.0.1:8000/planning/single
