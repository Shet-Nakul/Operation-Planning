# Database connection
DATABASE_URL="mysql://op_user:StrongPassword%40123@localhost:3306/operation_planning"
# JWT secret
JWT_SECRET="your_jwt_secret_here"

# JWT expiration (e.g., 1d, 12h)
JWT_EXPIRES_IN="1d"

# Server port
PORT=3333
# Server IP
IP=127.0.0.1

# Node environment
env=development

# Logger level
LOG_LEVEL=info

# (Optional) CORS allowed origins
CORS_ORIGIN=http://127.0.0.1:3333
