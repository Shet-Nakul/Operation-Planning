generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContractType {
  STATIC
  DYNAMIC
}

model Organization {
  id             Int      @id @default(autoincrement())
  name           String
  contact_number String?
  contact_email  String?
  status         String   @default("ACTIVE")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  users              User[]
  activity_logs      UserActivityLog[]
  global_settings    GlobalSettings?
  staff_tags         StaffTag[]
  specializations    Specialization[]
  skills             Skill[]
  shifts             Shift[]
  forbidden_patterns ForbiddenPattern[]
  contracts          Contract[]

  @@map("organizations")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  created_at  DateTime @default(now())
  users       User[]

  @@map("roles")
}

model User {
  id              Int               @id @default(autoincrement())
  organization_id Int?
  organization    Organization?     @relation(fields: [organization_id], references: [id])
  role_id         Int
  role            Role              @relation(fields: [role_id], references: [id])
  first_name      String
  last_name       String?
  email           String            @unique
  password_hash   String
  refresh_token   String?
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  activity_logs   UserActivityLog[]

  @@map("users")
}

model GlobalSettings {
  id                          Int          @id @default(autoincrement())
  organization_id             Int          @unique
  organization                Organization @relation(fields: [organization_id], references: [id])
  business_hours_start        String       @default("08:00")
  business_hours_end          String       @default("18:00")
  surgery_planning_horizon    Int          @default(3)
  roster_planning_horizon     Int          @default(28)
  surgery_planning_resolution Int          @default(15)
  created_at                  DateTime     @default(now())
  updated_at                  DateTime     @updatedAt

  @@map("global_settings")
}

model StaffTag {
  id              Int          @id @default(autoincrement())
  organization_id Int
  organization    Organization @relation(fields: [organization_id], references: [id])
  name            String
  color           String?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@map("staff_tags")
}

model Specialization {
  id              Int          @id @default(autoincrement())
  organization_id Int
  organization    Organization @relation(fields: [organization_id], references: [id])
  name            String
  description     String?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@map("specializations")
}

model Skill {
  id              Int          @id @default(autoincrement())
  organization_id Int
  organization    Organization @relation(fields: [organization_id], references: [id])
  name            String
  description     String?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@map("skills")
}

model Shift {
  id              Int          @id @default(autoincrement())
  organization_id Int
  organization    Organization @relation(fields: [organization_id], references: [id])
  name            String
  start_time      String
  end_time        String
  description     String?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@map("shifts")
}

model ForbiddenPattern {
  id                 Int          @id @default(autoincrement())
  organization_id    Int
  organization       Organization @relation(fields: [organization_id], references: [id])
  scope              String       @default("GLOBAL")
  applies_to         String       @default("ALL_CONTRACT_TYPES")
  forbidden_patterns Json         @default("[]")
  metadata           Json?        @default("{}")
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt

  @@map("forbidden_patterns")
}

model Contract {
  id              Int          @id @default(autoincrement())
  organization_id Int
  organization    Organization @relation(fields: [organization_id], references: [id])
  name            String
  type            ContractType
  status          String       @default("Active")
  staff_tags      Json         @default("[]")
  configuration   Json         @default("{}")
  global_settings Json?        @default("{}")
  metadata        Json?        @default("{}")
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@map("contracts")
}

model UserActivityLog {
  id              Int           @id @default(autoincrement())
  user_id         Int?
  user            User?         @relation(fields: [user_id], references: [id])
  organization_id Int?
  organization    Organization? @relation(fields: [organization_id], references: [id])
  action          String
  entity          String?
  entity_id       String?
  description     String?
  metadata        Json?
  created_at      DateTime      @default(now())

  @@map("user_activity_logs")
}
