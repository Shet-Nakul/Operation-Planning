{
  "name": "operation-planning-api",
  "version": "1.0.0",
  "description": "Production-ready REST API server for operation planning",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "prisma migrate deploy",
    "seed": "ts-node src/db/seed.ts"
  },
  "prisma": {
    "seed": "ts-node src/db/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.6",
    "dotenv": "^16.0.0",
    "express": "^4.22.1",
    "jsonwebtoken": "^9.0.0",
    "openapi-types": "^12.1.3",
    "swagger-ui-express": "^4.6.3",
    "winston": "^3.9.0",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}
