generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContractType {
  STATIC
  DYNAMIC
}

model Organization {
  id              Int      @id @default(autoincrement())
  name            String
  contact_number  String?
  contact_email   String?
  status          String   @default("ACTIVE")
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  users             User[]
  activity_logs     UserActivityLog[]
  global_settings   GlobalSettings?
  staff_tags        StaffTag[]
  specializations   Specialization[]
  departments       Department[]
  skills            Skill[]
  resource_types    ResourceType[]
  surgery_status_catalog SurgeryStatusCatalog[]
  shifts            Shift[]
  forbidden_patterns ForbiddenPattern[]
  contracts         Contract[]
  staff             Staff[]
  resource_pools    ResourcePool[]
  renewable_resource_pools RenewableResourcePool[]
  non_renewable_resources NonRenewableResource[]
  operation_types   OperationType[]
  phase_resources   PhaseResource[]
  rosterings        Rostering[]
  surgeries         Surgery[]
  leave_types       LeaveType[]
  leave_shift_requests LeaveShiftRequest[]

  @@map("organizations")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  created_at  DateTime @default(now())
  users       User[]

  @@map("roles")
}

model User {
  id              Int          @id @default(autoincrement())
  organization_id Int?
  organization    Organization? @relation(fields: [organization_id], references: [id])
  role_id         Int
  role            Role         @relation(fields: [role_id], references: [id])
  first_name      String
  last_name       String?
  email           String       @unique
  password_hash   String
  refresh_token   String?
  is_active       Boolean      @default(true)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  activity_logs   UserActivityLog[]

  @@map("users")
}

model GlobalSettings {
  id                        Int          @id @default(autoincrement())
  organization_id           Int          @unique
  organization              Organization @relation(fields: [organization_id], references: [id])
  operation_hours_start     String       @default("08:00")
  operation_hours_end       String       @default("18:00")
  surgery_planning_horizon  Int          @default(3)
  roster_planning_horizon   Int          @default(28)
  surgery_planning_resolution Int        @default(15)
  schedule_date             Int          @default(1)
  created_at                DateTime     @default(now())
  updated_at                DateTime     @updatedAt

  @@map("global_settings")
}

model StaffTag {
  id              Int          @id @default(autoincrement())
  organization_id Int
  organization    Organization @relation(fields: [organization_id], references: [id])
  name            String
  color           String?
  status          String       @default("ACTIVE")
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@unique([organization_id, name])
  @@map("staff_tags")
}

model Specialization {
  id              Int          @id @default(autoincrement())
  organization_id Int
  organization    Organization @relation(fields: [organization_id], references: [id])
  name            String
  description     String?
  status          String       @default("ACTIVE")
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@unique([organization_id, name])
  @@map("specializations")
}

model Department {
  id              Int              @id @default(autoincrement())
  organization_id Int
  organization    Organization     @relation(fields: [organization_id], references: [id])
  name            String
  description     String?
  status          String           @default("ACTIVE")
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  staff           Staff[]         @relation("StaffDepartment")
  resource_pools  ResourcePool[]  @relation("PoolDepartment")
  surgeries       Surgery[]       @relation("SurgeryDepartment")

  @@unique([organization_id, name])
  @@map("departments")
}

model Skill {
  id              Int          @id @default(autoincrement())
  organization_id Int
  organization    Organization @relation(fields: [organization_id], references: [id])
  name            String
  description     String?
  status          String       @default("ACTIVE")
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@unique([organization_id, name])
  @@map("skills")
}

model ResourceType {
  id              Int          @id @default(autoincrement())
  organization_id Int
  organization    Organization @relation(fields: [organization_id], references: [id])
  name            String
  status          String       @default("ACTIVE")
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@unique([organization_id, name])
  @@map("resource_types")
}

model LeaveType {
  id              Int          @id @default(autoincrement())
  organization_id Int
  organization    Organization @relation(fields: [organization_id], references: [id])
  name            String
  description     String?
  status          String       @default("ACTIVE")
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  leave_shift_requests LeaveShiftRequest[]

  @@unique([organization_id, name])
  @@map("leave_types")
}

model LeaveShiftRequest {
  id               Int          @id @default(autoincrement())
  organization_id  Int
  organization     Organization @relation(fields: [organization_id], references: [id])
  staff_id         Int
  staff            Staff        @relation(fields: [staff_id], references: [id])
  request_type     String
  leave_type_id    Int?
  leave_type       LeaveType?   @relation(fields: [leave_type_id], references: [id])
  shift_preference String?
  start_date       String
  end_date         String
  status           String       @default("PENDING")
  reason           String?
  requested_by_at  DateTime     @default(now())
  updated_by_at    DateTime?
  metadata         Json?        @default("{}")
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  @@map("leave_shift_requests")
}

model SurgeryStatusCatalog {
  id              Int          @id @default(autoincrement())
  organization_id Int
  organization    Organization @relation(fields: [organization_id], references: [id])
  name            String                               // e.g. DRAFT, ESTIMATED, PLANNING
  to_plan         Boolean      @default(false)         // if true, surgeries with this status are included in planning payloads
  description     String?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@unique([organization_id, name])
  @@map("surgery_status_catalog")
}

model Shift {
  id              Int          @id @default(autoincrement())
  organization_id Int
  organization    Organization @relation(fields: [organization_id], references: [id])
  name            String
  alias           String
  start_time      String
  end_time        String
  description     String?
  status          String       @default("ACTIVE")
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@unique([organization_id, name])
  @@map("shifts")
}

model ForbiddenPattern {
  id                Int          @id @default(autoincrement())
  organization_id   Int
  organization      Organization @relation(fields: [organization_id], references: [id])
  scope             String       @default("GLOBAL")
  applies_to        String       @default("ALL_CONTRACT_TYPES")
  forbidden_patterns Json        @default("[]")
  metadata          Json?        @default("{}")
  created_at        DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@map("forbidden_patterns")
}

model Contract {
  id              Int          @id @default(autoincrement())
  contract_id     String       @unique
  organization_id Int
  organization    Organization @relation(fields: [organization_id], references: [id])
  name            String
  type            ContractType
  status          String       @default("Active")
  staff_tags      Json         @default("[]")
  configuration   Json         @default("{}")
  global_settings Json?        @default("{}")
  metadata        Json?        @default("{}")
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@unique([organization_id, name])
  @@map("contracts")
}

model UserActivityLog {
  id              Int           @id @default(autoincrement())
  user_id         Int?
  user            User?         @relation(fields: [user_id], references: [id])
  organization_id Int?
  organization    Organization? @relation(fields: [organization_id], references: [id])
  action          String
  entity          String?
  entity_id       String?
  description     String?
  metadata        Json?
  created_at      DateTime      @default(now())

  @@map("user_activity_logs")
}

model Staff {
  id              Int              @id @default(autoincrement())
  organization_id Int
  organization    Organization     @relation(fields: [organization_id], references: [id])
  staff_id        String           @unique

  // Personal Details
  name            String
  address         String?
  phone           String?
  email           String?
  profile_picture String?

  // Professional Primary Details
  department_id   Int?
  departmentRel Department?     @relation("StaffDepartment", fields: [department_id], references: [id])
  department      String?          // Backwards compatibility
  designation     String?
  contract_id     String? // Reference to Contract name or ID
  supervisor      String?
  
  // Professional Secondary Details
  skills          Json?        @default("[]")
  certifications  Json?        @default("[]")
  roles           Json?        @default("[]")
  role_distribution Json?      @default("{}")
  weekly_template Json?        @default("{}")
  pool_assignments Json?       @default("[]")
  leave_shift_requests LeaveShiftRequest[]
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@map("staff")
}

model ResourcePool {
  id              Int              @id @default(autoincrement())
  organization_id Int
  organization    Organization     @relation(fields: [organization_id], references: [id])
  pool_id         String           @unique
  pool_name       String
  department_id   Int?
  departmentRel   Department?      @relation("PoolDepartment", fields: [department_id], references: [id])
  department      String?          // Backwards compatibility
  location        String?
  primary_role    String?
  static_pct      Int          @default(50)
  dynamic_pct     Int          @default(50)
  metadata        Json?        @default("{}")
  
  demand_configs  PoolDemandConfig[]
  resources       PoolResource[]

  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@map("resource_pools")
}

model PoolResource {
  id              Int          @id @default(autoincrement())
  resource_id     String       @unique
  pool_id         Int
  pool            ResourcePool @relation(fields: [pool_id], references: [id], onDelete: Cascade)
  name            String
  description     String?
  status          String       @default("AVAILABLE")
  weekly_template Json         @default("{}")
  block_bookings  Json         @default("[]")
  reservations    PoolResourceReservation[]
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@map("pool_resources")
}

model PoolResourceReservation {
  id              Int          @id @default(autoincrement())
  reservation_id  String       @unique
  resource_id     Int
  resource        PoolResource @relation(fields: [resource_id], references: [id], onDelete: Cascade)
  date            String
  start_time      String
  end_time        String
  reason          String?
  reference_id    String?
  status          String       @default("ACTIVE")
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@map("pool_resource_reservations")
}

model PoolDemandConfig {
  id              Int          @id @default(autoincrement())
  pool_id         Int
  pool            ResourcePool @relation(fields: [pool_id], references: [id])
  effective_from  DateTime
  effective_to    DateTime?
  demand_matrix   Json         @default("[]")
  weekly_hours    Int          @default(0)
  
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@map("pool_demand_configs")
}

model RenewableResourcePool {
  id              Int          @id @default(autoincrement())
  organization_id Int
  organization    Organization @relation(fields: [organization_id], references: [id])
  pool_id         String       @unique
  pool_name       String
  resource_type   String       // BED, EQUIPMENT, ROOM, DEVICE, VEHICLE
  department      String?
  location        String?
  total_capacity  Int          @default(0)
  status          String       @default("OPERATIONAL") // OPERATIONAL, MAINTENANCE, DECOMMISSIONED
  weekly_template Json?        @default("{}") // per-day open hours: {monday: [["HH:mm","HH:mm"]], ...}
  reservations    Json?        @default("[]") // [{id, resource_id, start, end, type}]
  metadata        Json?        @default("{}")
  
  units           ResourceUnit[]
  
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@map("renewable_resource_pools")
}

model ResourceUnit {
  id              Int                   @id @default(autoincrement())
  pool_id         Int
  pool            RenewableResourcePool @relation(fields: [pool_id], references: [id])
  unit_id         String                @unique
  status          String                @default("AVAILABLE") // AVAILABLE, IN_USE, MAINTENANCE, RESERVED, BLOCKED
  status_till     DateTime?             // when the current status is expected to expire
  variant         String?
  attributes      Json?                 @default("{}")
  block_bookings  Json                  @default("[]") // [{type:"date_range",from,to,reason?}|{type:"weekly",day,start,end,reason?}]

  assigned_to     String?
  assigned_at     DateTime?
  estimated_release DateTime?
  last_released_at DateTime?

  reservations    ResourceUnitReservation[]

  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt

  @@map("resource_units")
}

model ResourceUnitReservation {
  id              Int          @id @default(autoincrement())
  reservation_id  String       @unique
  unit_id         Int
  unit            ResourceUnit @relation(fields: [unit_id], references: [id], onDelete: Cascade)
  from_datetime   String
  to_datetime     String
  reason          String?
  reference_id    String?
  status          String       @default("ACTIVE") // ACTIVE, CANCELLED
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@map("resource_unit_reservations")
}

model NonRenewableResource {
  id                Int          @id @default(autoincrement())
  organization_id   Int
  organization      Organization @relation(fields: [organization_id], references: [id])
  resource_id       String       @unique
  name              String
  spec              String?
  category          String       // BLOOD_PRODUCT, MEDICATION, SUPPLY, etc.
  uom               String       // UNIT, BAG, BOTTLE, ML, MG, etc.
  stockpile_qty     Int          @default(0)
  min_required_qty  Int          @default(0)
  status            String       @default("AVAILABLE") // AVAILABLE, SHORTAGE, OUT_OF_STOCK, MAINTENANCE
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  @@map("non_renewable_resources")
}

model OperationType {
  id                Int          @id @default(autoincrement())
  organization_id   Int
  organization      Organization @relation(fields: [organization_id], references: [id])
  category          String
  name              String
  status          String       @default("ACTIVE")
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  @@unique([organization_id, category, name])
  @@map("operation_types")
}

model PhaseResource {
  id                Int          @id @default(autoincrement())
  organization_id   Int
  organization      Organization @relation(fields: [organization_id], references: [id])
  type              String
  name              String
  default_count     Int          @default(1)
  roles             Json         @default("[]")
  status            String       @default("ACTIVE")
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  @@map("phase_resources")
}

model SurgeryPlanResult {
  id              Int      @id @default(autoincrement())
  surgery_id      String   @unique
  organization_id Int
  department      String
  result          Json
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("surgery_plan_results")
}

model Rostering {
  id                Int      @id @default(autoincrement())
  organization_id   Int
  organization      Organization @relation(fields: [organization_id], references: [id])
  year              Int
  month             Int
  employee_centric  Json
  pool_centric      Json
  date_centric      Json
  stats             Json
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@unique([organization_id, year, month])
  @@map("rosterings")
}

model Surgery {
  id              Int          @id @default(autoincrement())
  organization_id Int
  organization    Organization @relation(fields: [organization_id], references: [id])
  surgery_id      String       @unique
  name            String
  type            String
  infection_type  Int          @default(0)
  department_id   Int?
  departmentRel   Department?  @relation("SurgeryDepartment", fields: [department_id], references: [id])
  department      String?          // Backwards compatibility
  status          String       @default("DRAFT") // DRAFT -> ESTIMATED -> PLANNING -> PLANNED -> IN_PROGRESS -> DONE | CANCELLED
  time_windows    Json         @default("{}")
  stages          Json         @default("{}")
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@map("surgeries")
}
